# === Providers LLM ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...

# === Provider par défaut ===
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-4-6

# === Application ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# === CORS — Origines autorisées (production uniquement) ===
# Ignoré en développement (APP_DEBUG=true → tout est autorisé).
# En production, mettre le domaine exact du frontend.
# Format JSON : ALLOWED_ORIGINS=["https://monsite.com"]
# ALLOWED_ORIGINS=[]

# === Contrôle d'accès à l'inscription ===
# Liste blanche des emails autorisés à créer un compte.
# Vide (commenté ou absent) = inscription ouverte à tous.
# Format JSON : ALLOWED_EMAILS=["alice@cabinet.fr","bob@cabinet.fr"]
# ALLOWED_EMAILS=[]

# === Authentification JWT ===
# Clé secrète utilisée pour signer les tokens JWT.
# OBLIGATOIRE en production — ne jamais laisser la valeur par défaut.
# Générer une clé forte : openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 jours

# === Timeouts LLM ===
# Durée max d'un appel LLM individuel en secondes (défaut : 60).
# Temps total max = brief (60s) + sections en parallèle (60s) ≈ 2 minutes.
# Augmenter si tes générations dépassent régulièrement 60s.
# LLM_TIMEOUT_SECONDS=60

# === RAG — Base de connaissances (optionnel) ===
# Si absent, la génération fonctionne sans enrichissement documentaire (dégradation gracieuse)
QDRANT_URL=http://qdrant:6333       # URL de la base vectorielle Qdrant
RAG_ETL_URL=http://rag-etl:8001    # URL du microservice ETL (proxy /index depuis l'API)
