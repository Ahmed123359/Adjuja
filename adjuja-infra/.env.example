# === Providers LLM ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...

# === Provider par défaut ===
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-4-6

# === Application ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# === CORS  Origines autorisées (production uniquement) ===
# Ignoré en développement (APP_DEBUG=true → tout est autorisé).
# En production, mettre le domaine exact du frontend.
# Format JSON : ALLOWED_ORIGINS=["https://monsite.com"]
# ALLOWED_ORIGINS=[]

# === Contrôle d'accès à l'inscription ===
# Liste blanche des emails autorisés à créer un compte.
# Vide (commenté ou absent) = inscription ouverte à tous.
# Format JSON : ALLOWED_EMAILS=["alice@cabinet.fr","bob@cabinet.fr"]
# ALLOWED_EMAILS=[]

# === Authentification JWT ===
# Clé secrète utilisée pour signer les tokens JWT.
# OBLIGATOIRE en production  ne jamais laisser la valeur par défaut.
# Générer une clé forte : openssl rand -hex 32
# Generer une cle propre a chaque environnement : openssl rand -base64 32
# Minimum 32 caracteres, jamais la valeur d'exemple (validateur au demarrage).
JWT_SECRET_KEY=<a-generer-ne-jamais-committer>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 jours

# === Limites de contexte AO ===
# Nombre max de caractères du texte AO injectés dans le prompt de génération.
# 100 000 chars ≈ 25 000 tokens  couvre 99%+ des AOs réels (max observé ~101k chars).
# Réduire pour limiter les coûts : 30000 ≈ 7500 tokens ≈ ~38% de couverture.
# AO_MAX_CHARS=100000

# === Timeouts LLM ===
# Durée max d'un appel LLM individuel en secondes (défaut : 60).
# Temps total max = brief (60s) + sections en parallèle (60s) ≈ 2 minutes.
# Augmenter si tes générations dépassent régulièrement 60s.
# LLM_TIMEOUT_SECONDS=60

# === RAG  Base de connaissances (optionnel) ===
# Si absent, la génération fonctionne sans enrichissement documentaire (dégradation gracieuse)
QDRANT_URL=http://qdrant:6333       # URL de la base vectorielle Qdrant
RAG_ETL_URL=http://rag-etl:8001    # URL du microservice ETL (proxy /index depuis l'API)

# === Worker  Scraper marchespublics.gov.ma ===
# Identité fictive pour le formulaire de retrait des dossiers
WORKER_FAKE_NOM=Dupont
WORKER_FAKE_PRENOM=Jean
WORKER_FAKE_EMAIL=jean.dupont@exemple.ma
# Acheteurs ciblés  format JSON, un ou plusieurs noms exacts du portail
WORKER_ACHETEURS=["OFFICE NATIONAL DES CHEMINS DE FER"]
# Paramètres de scraping
WORKER_MAX_AOS=20
WORKER_HEADLESS=true
WORKER_SLOW_MO=200
# Intervalle entre deux scrapes (en heures)
WORKER_SCHEDULE_HOURS=6
# Chemins  DEV LOCAL (décommenter si tu lances avec python, pas Docker)
# WORKER_DB_PATH=./data/ao_catalog.db
# WORKER_OUTPUT_DIR=./worker/output
# WORKER_HEADLESS=false

# === Billing  CMI (paiement carte MAD, plan Starter self-serve) ===
# Vide = le checkout Starter refuse proprement (503 "CMI non configuré"), le
# reste de l'app fonctionne normalement. À remplir une fois le compte marchand
# CMI obtenu -- voir context/feature-specs/01-billing-subscriptions/api.md.
# CMI_MERCHANT_ID=
# CMI_STORE_KEY=
# CMI_API_URL=
# CMI_OK_URL=https://adjuja.com/billing/success
# CMI_FAIL_URL=https://adjuja.com/billing/failed
# CMI_CALLBACK_URL=https://adjuja.com/api/v1/billing/webhook/cmi

# === Billing  dunning et révocation ===
# BILLING_DUNNING_GRACE_DAYS=5
# Secret pour POST /billing/admin/activate (activation manuelle Pro/Entreprise)
# Secret de la route POST /billing/admin/activate (activation manuelle d'un plan,
# par virement bancaire, hors CMI). Sans valeur, la route repond 403.
# Generer avec : openssl rand -hex 24
# BILLING_ADMIN_SECRET=

# === Notification-service (emails de relance billing, réutilise le service existant) ===
# NOTIFICATION_SERVICE_URL=http://notification-api:8002
# NOTIFICATION_ADMIN_SECRET=   # même valeur que ADMIN_SECRET du notification-service
